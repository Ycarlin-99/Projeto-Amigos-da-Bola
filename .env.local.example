# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Onde achar: painel do Supabase > Project Settings > Data API / API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# A chave "anon" é pública de propósito: quem protege os dados é o RLS
# configurado em supabase/schema.sql. Nunca coloque a chave "service_role" aqui.
